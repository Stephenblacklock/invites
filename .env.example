# Required
INVITES_PASSWORD=change-me-to-something-long   # shared password, at least 8 characters
ORIGIN=https://invites.blacklocks.uk           # the public URL; needed for form CSRF checks behind the proxy

# Optional
# INVITES_API_TOKEN=                          # enables /api/v1 (bearer token, at least 24 chars); unset = API off
# INVITES_API_PERSON=Stephen                   # name the API acts as
# SESSION_SECRET=                              # otherwise generated once and stored in the database
# DB_PATH=/data/invites.db
# TZ=Europe/London
# PORT=3000
